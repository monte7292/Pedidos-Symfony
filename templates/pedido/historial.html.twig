{% extends 'base.html.twig' %}

{% block title %}Historial de Pedidos{% endblock %}

{% block body %}
{% include 'cabecera.html.twig' %}

<style>
    :root {
        --bg-gradient: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        --glass-bg: rgba(255, 255, 255, 0.8);
        --accent-color: #6366f1; /* Indigo moderno */
        --text-main: #1e293b;
        --text-muted: #64748b;
        --shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
    }

    body {
        background: var(--bg-gradient);
        min-height: 100vh;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: var(--text-main);
    }

    .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 40px 20px;
    }

    .header-section {
        margin-bottom: 40px;
        text-align: center;
    }

    .header-section h1 {
        font-size: 2.5rem;
        font-weight: 800;
        background: linear-gradient(to right, #4f46e5, #9333ea);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 10px;
    }

    /* Grid de 4 columnas */
    .pedidos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 25px;
    }

    /* Tarjeta Estilo Moderno */
    .pedido-card {
        background: var(--glass-bg);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 24px;
        padding: 24px;
        box-shadow: var(--shadow);
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
    }

    .pedido-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
        border-color: var(--accent-color);
    }

    .pedido-tag {
        position: absolute;
        top: 20px;
        right: 20px;
        background: rgba(99, 102, 241, 0.1);
        color: var(--accent-color);
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .pedido-date {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-bottom: 8px;
    }

    .pedido-title {
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 20px;
    }

    /* Lista de productos interior */
    .productos-list {
        flex-grow: 1;
        border-top: 1px solid rgba(0,0,0,0.05);
        padding-top: 15px;
        margin-bottom: 15px;
    }

    .producto-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
        font-size: 0.95rem;
    }

    .qty-bubble {
        background: #e2e8f0;
        padding: 2px 8px;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    /* Footer de la tarjeta */
    .pedido-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: auto;
    }

    .total-label {
        color: var(--text-muted);
        font-size: 0.85rem;
        font-weight: 500;
    }

    .total-price {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--text-main);
    }

    .total-price span {
        color: var(--accent-color);
        font-size: 1rem;
        margin-left: 2px;
    }

    /* Empty State */
    .empty-container {
        grid-column: 1 / -1;
        text-align: center;
        padding: 100px 20px;
        background: var(--glass-bg);
        border-radius: 30px;
        border: 2px dashed #cbd5e1;
    }

    /* Responsive para pantallas muy grandes */
    @media (min-width: 1400px) {
        .pedidos-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    @media (max-width: 768px) {
        .pedidos-grid {
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        }
    }
</style>

<div class="container">
    <div class="header-section">
        <h1>Mi Historial</h1>
        <p style="color: var(--text-muted)">Repasa tus compras anteriores y detalles de envío.</p>
    </div>

    <div class="pedidos-grid">
        {% for pedido in pedidos %}
            <div class="pedido-card">
                <div class="pedido-tag">COMPLETADO</div>
                
                <div class="pedido-date">
                    <i class="far fa-calendar-alt"></i> {{ pedido.fecha|date('d M, Y') }}
                </div>
                
                <div class="pedido-title">Pedido #{{ pedido.id }}</div>

                <div class="productos-list">
                    {% for item in pedido.pedidoProductos %}
                        <div class="producto-item">
                            <span>{{ item.producto.nombre }}</span>
                            <span class="qty-bubble">x{{ item.unidades }}</span>
                        </div>
                    {% endfor %}
                </div>

                <div class="pedido-footer">
                    <div class="total-label">Total pagado</div>
                    <div class="total-price">
                        {{ pedido.coste|number_format(2, ',', '.') }}<span>€</span>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="empty-container">
                <h3>Aún no has realizado pedidos</h3>
                <p>Cuando realices tu primera compra, aparecerá aquí.</p>
                <a href="/" style="display: inline-block; margin-top: 20px; color: var(--accent-color); font-weight: 600; text-decoration: none;">Ir a la tienda →</a>
            </div>
        {% endfor %}
    </div>
</div>

{% endblock %}